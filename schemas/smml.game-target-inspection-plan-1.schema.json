{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smml:schema:game-target-inspection-plan:1",
  "title": "SMML GameTargetInspectionPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "steamAppId", "canonicalPolicy", "builds"],
  "properties": {
    "schema": {"const": "smml.game-target-inspection-plan/1"},
    "steamAppId": {"type": "integer", "minimum": 1},
    "canonicalPolicy": {"const": "smml.canonical-game-policy/1"},
    "builds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/build"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "os": {
      "type": "string",
      "enum": ["linux", "windows", "macos"]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steamBuildId",
        "steamBranch",
        "gameVersion",
        "engineBuild",
        "gameOs",
        "rootFingerprints",
        "targetFingerprints"
      ],
      "properties": {
        "steamBuildId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "minLength": 1,
          "maxLength": 32
        },
        "steamBranch": {"type": "string", "minLength": 1, "maxLength": 128},
        "gameVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z._+\\-]*$"
        },
        "engineBuild": {"type": "integer", "minimum": 0},
        "gameOs": {"$ref": "#/$defs/os"},
        "gameArch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "rootFingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "targetFingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      }
    }
  }
}
