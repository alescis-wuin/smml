{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smml:schema:canonical-game-policy:2",
  "title": "SMML Canonical Game Policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contentTreeAlgorithm",
    "excludedFilePrefixes",
    "excludedExactFiles",
    "includeEverythingElse"
  ],
  "properties": {
    "schema": {
      "const": "smml.canonical-game-policy/2"
    },
    "contentTreeAlgorithm": {
      "const": "smml.content-tree-sha256/1"
    },
    "excludedFilePrefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 4096,
        "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+/$"
      }
    },
    "excludedExactFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "includeEverythingElse": {
      "const": true
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
    }
  }
}
