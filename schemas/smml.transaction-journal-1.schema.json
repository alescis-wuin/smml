{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smml:schema:transaction-journal:1",
  "title": "SMML TransactionJournal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transactionId",
    "journalRevision",
    "phase",
    "createdAt",
    "updatedAt",
    "gameTarget",
    "operations",
    "phaseHistory",
    "incidents"
  ],
  "properties": {
    "schema": {
      "const": "smml.transaction-journal/1"
    },
    "transactionId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128,
      "pattern": "^tx-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "journalRevision": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "createdAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "gameTarget": {
      "$ref": "urn:smml:schema:game-target:1"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "phaseHistory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/phaseHistoryEntry"
      }
    },
    "incidents": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/incident"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "PLANNED",
        "PREPARED",
        "COMMITTING",
        "VERIFYING",
        "COMMITTED",
        "RECOVERY_REQUIRED",
        "FOREIGN_MODIFICATION",
        "ROLLBACK_REQUIRED",
        "FAILED"
      ]
    },
    "operationStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPLIED",
        "VERIFIED",
        "ROLLED_BACK"
      ]
    },
    "fileState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exists": {
                "const": true
              }
            },
            "required": [
              "exists"
            ]
          },
          "then": {
            "required": [
              "sha256"
            ]
          },
          "else": {
            "not": {
              "required": [
                "sha256"
              ]
            }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "sequence",
        "path",
        "kind",
        "owner",
        "before",
        "after",
        "status"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "kind": {
          "type": "string",
          "enum": [
            "create",
            "replace",
            "delete"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "before": {
          "$ref": "#/$defs/fileState"
        },
        "after": {
          "$ref": "#/$defs/fileState"
        },
        "status": {
          "$ref": "#/$defs/operationStatus"
        }
      }
    },
    "phaseHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "at",
        "phase"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        }
      }
    },
    "observedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "missing",
            "file",
            "directory",
            "symlink",
            "reparsePoint",
            "other"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "sha256"
            ]
          },
          "else": {
            "not": {
              "required": [
                "sha256"
              ]
            }
          }
        }
      ]
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incidentId",
        "kind",
        "reasonCode",
        "detectedAt",
        "detectedRevision"
      ],
      "properties": {
        "incidentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "RECOVERY_REQUIRED",
            "FOREIGN_MODIFICATION",
            "ROLLBACK_REQUIRED",
            "FAILED"
          ]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "detectedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "detectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "observed": {
          "$ref": "#/$defs/observedObject"
        },
        "detail": {
          "type": "string",
          "maxLength": 2048
        }
      }
    }
  }
}
