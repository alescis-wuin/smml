{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smml:schema:transaction-recovery-report:1",
  "title": "SMML Transaction Recovery Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "transactionId",
    "journalRevision",
    "journalPhase",
    "inspectedAt",
    "gameTargetBinding",
    "summary",
    "operations",
    "recovery"
  ],
  "properties": {
    "schema": {"const": "smml.transaction-recovery-report/1"},
    "mode": {"const": "read-only"},
    "transactionId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128,
      "pattern": "^tx-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "journalRevision": {"type": "integer", "minimum": 0},
    "journalPhase": {"$ref": "#/$defs/phase"},
    "inspectedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "gameTargetBinding": {"$ref": "#/$defs/gameTargetBinding"},
    "summary": {"$ref": "#/$defs/summary"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/operationReport"}
    },
    "recovery": {"$ref": "#/$defs/recovery"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {
      "type": "string",
      "enum": [
        "PLANNED",
        "PREPARED",
        "COMMITTING",
        "VERIFYING",
        "COMMITTED",
        "RECOVERY_REQUIRED",
        "FOREIGN_MODIFICATION",
        "ROLLBACK_REQUIRED",
        "FAILED"
      ]
    },
    "bindingMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "expected", "actual"],
      "properties": {
        "field": {"type": "string", "minLength": 1, "maxLength": 512},
        "expected": true,
        "actual": true
      }
    },
    "gameTargetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mismatches"],
      "properties": {
        "status": {"type": "string", "enum": ["MATCH", "MISMATCH"]},
        "mismatches": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/bindingMismatch"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "MATCH"}}, "required": ["status"]},
          "then": {"properties": {"mismatches": {"maxItems": 0}}},
          "else": {"properties": {"mismatches": {"minItems": 1}}}
        }
      ]
    },
    "pathSafetyIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "component"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ANCESTOR_MISSING",
            "ANCESTOR_NOT_DIRECTORY",
            "CASE_MISMATCH",
            "SYMLINK_FORBIDDEN",
            "REPARSE_POINT_FORBIDDEN",
            "HARDLINK_FORBIDDEN"
          ]
        },
        "component": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "pathSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": {"type": "string", "enum": ["SAFE", "BLOCKED"]},
        "issues": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/pathSafetyIssue"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "SAFE"}}, "required": ["status"]},
          "then": {"properties": {"issues": {"maxItems": 0}}},
          "else": {"properties": {"issues": {"minItems": 1}}}
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stable", "pathSafety"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["missing", "file", "directory", "symlink", "reparsePoint", "other"]
        },
        "stable": {"const": true},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0},
        "linkCount": {"type": "integer", "minimum": 1},
        "blockedAt": {"type": "string", "minLength": 1, "maxLength": 4096},
        "pathSafety": {"$ref": "#/$defs/pathSafety"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "file"}}, "required": ["kind"]},
          "then": {"required": ["sha256", "size", "linkCount"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["sha256"]},
                {"required": ["size"]},
                {"required": ["linkCount"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"pathSafety": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}}, "required": ["pathSafety"]},
          "then": {"required": ["blockedAt"]}
        }
      ]
    },
    "operationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "sequence",
        "path",
        "kind",
        "journalStatus",
        "observation",
        "classification",
        "journalStatusAssessment"
      ],
      "properties": {
        "operationId": {"type": "string", "minLength": 1, "maxLength": 128},
        "sequence": {"type": "integer", "minimum": 0},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "kind": {"type": "string", "enum": ["create", "replace", "delete"]},
        "journalStatus": {"type": "string", "enum": ["PENDING", "APPLIED", "VERIFIED", "ROLLED_BACK"]},
        "observation": {"$ref": "#/$defs/observation"},
        "classification": {"type": "string", "enum": ["BEFORE", "AFTER", "FOREIGN"]},
        "journalStatusAssessment": {
          "type": "string",
          "enum": ["MATCHES_OBSERVED_STATE", "STALE_STATUS", "STATE_REGRESSED", "FOREIGN"]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationCount", "beforeCount", "afterCount", "foreignCount", "unsafePathCount"],
      "properties": {
        "operationCount": {"type": "integer", "minimum": 1},
        "beforeCount": {"type": "integer", "minimum": 0},
        "afterCount": {"type": "integer", "minimum": 0},
        "foreignCount": {"type": "integer", "minimum": 0},
        "unsafePathCount": {"type": "integer", "minimum": 0}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "NO_RECOVERY_NEEDED",
            "RESUME_COMMIT",
            "READY_TO_VERIFY",
            "RECOVERY_REQUIRED",
            "FOREIGN_MODIFICATION",
            "PATH_POLICY_BLOCKED",
            "ROLLBACK_REQUIRED",
            "ROLLBACK_COMPLETE",
            "TERMINAL_COMMITTED",
            "TERMINAL_FAILED",
            "TARGET_MISMATCH"
          ]
        },
        "nextSequence": {"type": "integer", "minimum": 0},
        "rollbackSequences": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "RESUME_COMMIT"}}, "required": ["decision"]},
          "then": {"required": ["nextSequence"]},
          "else": {"not": {"required": ["nextSequence"]}}
        },
        {
          "if": {"properties": {"decision": {"const": "ROLLBACK_REQUIRED"}}, "required": ["decision"]},
          "then": {"required": ["rollbackSequences"]},
          "else": {"not": {"required": ["rollbackSequences"]}}
        }
      ]
    }
  }
}
