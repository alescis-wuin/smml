{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smml:schema:game-target:1",
  "title": "SMML GameTargetIdentity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "steamAppId",
    "gameVersion",
    "engineBuild",
    "steamBuildId",
    "steamBranch",
    "platform",
    "fingerprints"
  ],
  "properties": {
    "schema": {
      "const": "smml.game-target/1"
    },
    "steamAppId": {
      "type": "integer",
      "minimum": 1
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._+\\-]*$"
    },
    "engineBuild": {
      "type": "integer",
      "minimum": 0
    },
    "steamBuildId": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "minLength": 1,
      "maxLength": 32
    },
    "steamBranch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "platform": {
      "$ref": "#/$defs/platform"
    },
    "fingerprints": {
      "$ref": "#/$defs/fingerprints"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "os": {
      "type": "string",
      "enum": [
        "linux",
        "windows",
        "macos"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostOs",
        "gameOs",
        "compatibilityLayer"
      ],
      "properties": {
        "hostOs": {
          "$ref": "#/$defs/os"
        },
        "gameOs": {
          "$ref": "#/$defs/os"
        },
        "hostArch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "gameArch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "compatibilityLayer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "none",
                "proton",
                "wine",
                "other"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "treeFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "fileCount",
        "totalFileBytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalFileBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalPolicy",
        "installationExactFingerprint",
        "canonicalGameFingerprint",
        "rootFingerprints",
        "targetFingerprints"
      ],
      "properties": {
        "algorithm": {
          "const": "smml.content-tree-sha256/1"
        },
        "canonicalPolicy": {
          "type": "string",
          "enum": [
            "smml.canonical-game-policy/1",
            "smml.canonical-game-policy/2"
          ]
        },
        "installationExactFingerprint": {
          "$ref": "#/$defs/treeFingerprint"
        },
        "canonicalGameFingerprint": {
          "$ref": "#/$defs/treeFingerprint"
        },
        "rootFingerprints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rootFingerprint"
          }
        },
        "targetFingerprints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileFingerprint"
          }
        }
      }
    },
    "rootFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "algorithm",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "algorithm": {
          "const": "smml.content-tree-sha256/1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fileFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "algorithm",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "algorithm": {
          "const": "sha256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
